{
  "port": 5599,
  "strict": true,
  "max_rate_hz": 100,
  "groups": {
    "drive-power": {
      "title": "Drive Power",
      "fields": {
        "front_left_power": {},
        "front_right_power": {},
        "back_left_power": {},
        "back_right_power": {}
      }
    },
    "drive-encoder": {
      "title": "Drive Encoders",
      "fields": {
        "front_left_position": { "type": "long", "unit": "ticks" },
        "front_right_position": { "type": "long", "unit": "ticks" },
        "back_left_position": { "type": "long", "unit": "ticks" },
        "back_right_position": { "type": "long", "unit": "ticks" }
      }
    },
    "imu": {
      "title": "IMU (deg)",
      "fields": {
        "imu_yaw_deg": { "unit": "deg" },
        "imu_pitch_deg": { "unit": "deg" },
        "imu_roll_deg": { "unit": "deg" }
      }
    },
    "driver-input": {
      "title": "Driver Input",
      "fields": {
        "drive_forward": {},
        "drive_right": {},
        "drive_rotate": {}
      }
    },
    "battery-hub-power": {
      "title": "Battery / Hub Power",
      "fields": {
        "battery_voltage": { "unit": "V" },
        "hub_input_volts": { "unit": "V" },
        "hub_current_amps": { "unit": "A" }
      }
    },
    "motor-current": {
      "title": "Motor Current",
      "fields": {
        "front_left_current_amps": { "unit": "A" },
        "front_right_current_amps": { "unit": "A" },
        "back_left_current_amps": { "unit": "A" },
        "back_right_current_amps": { "unit": "A" }
      }
    },
    "metadata": {
      "graph": false,
      "fields": {
        "run_id": { "type": "long", "unit": "s" },
        "robot_ts_ms": { "type": "long", "unit": "ms" },
        "field_relative": { "type": "long" }
      }
    }
  }
}
